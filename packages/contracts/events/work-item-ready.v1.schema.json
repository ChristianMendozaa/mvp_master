{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.mvp-master.test/events/work-item-ready.v1.schema.json",
  "title": "Work item ready v1 data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_item_id",
    "project_id",
    "repository_connection_id",
    "provider_configuration_id",
    "runner_pool_id",
    "budget",
    "title",
    "description",
    "acceptance_criteria"
  ],
  "properties": {
    "work_item_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "repository_connection_id": { "type": "string", "format": "uuid" },
    "provider_configuration_id": { "type": "string", "format": "uuid" },
    "runner_pool_id": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_duration_seconds", "max_attempts", "max_turns", "max_cost_minor"],
      "properties": {
        "max_duration_seconds": { "type": "integer", "minimum": 1 },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "max_turns": { "type": "integer", "minimum": 1 },
        "max_cost_minor": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "default": "USD" }
      }
    }
  }
}
