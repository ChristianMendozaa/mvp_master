            "title": "Reason"
          }
        },
        "title": "ApprovalDecision",
        "type": "object"
      },
      "BudgetRequest": {
        "additionalProperties": false,
        "properties": {
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          },
          "max_attempts": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Max Attempts",
            "type": "integer"
          },
          "max_cost_minor": {
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Max Cost Minor",
            "type": "integer"
          },
          "max_duration_seconds": {
            "maximum": 86400.0,
            "minimum": 30.0,
            "title": "Max Duration Seconds",
            "type": "integer"
          },
          "max_turns": {
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Turns",
            "type": "integer"
          }
        },
        "required": [
          "max_duration_seconds",
          "max_attempts",
          "max_turns",
          "max_cost_minor",
          "currency"
        ],
        "title": "BudgetRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
