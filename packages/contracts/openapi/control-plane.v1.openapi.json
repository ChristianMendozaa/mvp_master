          "client_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "constraints": {
            "default": [],
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Constraints",
            "type": "array"
          },
          "exclusions": {
            "default": [],
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Exclusions",
            "type": "array"
          },
          "intended_users": {
            "maxLength": 4000,
            "minLength": 2,
            "title": "Intended Users",
            "type": "string"
          },
          "problem": {
            "maxLength": 10000,
            "minLength": 10,
            "title": "Problem",
            "type": "string"
          },
          "project_id": {
            "format": "uuid",
            "title": "Project Id",
            "type": "string"
          },
          "required_functionality": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Required Functionality",
            "type": "array"
          }
        },
        "required": [
          "project_id",
          "problem",
          "intended_users",
          "required_functionality"
        ],
        "title": "IntakeCreate",
        "type": "object"
      },
      "OrganizationCreate": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "OrganizationCreate",
        "type": "object"
