            "title": "Success",
            "type": "boolean"
          },
          "summary": {
            "maxLength": 4000,
            "title": "Summary",
            "type": "string"
          },
          "turns": {
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Turns",
            "type": "integer"
          }
        },
        "required": [
          "success",
          "summary",
          "turns",
          "changed_paths",
          "events"
        ],
        "title": "AgentReport",
        "type": "object"
      },
