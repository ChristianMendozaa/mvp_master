{
  "components": {
    "schemas": {
      "ConnectionCreate": {
        "additionalProperties": false,
        "properties": {
          "account_login": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Account Login",
            "type": "string"
          },
          "external_account_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "External Account Id",
            "type": "string"
          },
          "provider": {
            "default": "github-local",
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "external_account_id",
          "account_login"
        ],
        "title": "ConnectionCreate",
        "type": "object"
      },
      "GitHubInstallationComplete": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[A-Za-z0-9_-]{8,512}$",
            "title": "Code",
            "type": "string"
          },
          "installation_id": {
            "pattern": "^[0-9]{1,32}$",
            "title": "Installation Id",
            "type": "string"
          },
          "state": {
            "maxLength": 256,
            "minLength": 32,
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "code",
          "installation_id"
        ],
        "title": "GitHubInstallationComplete",
        "type": "object"
      },
      "GitHubInstallationStart": {
        "additionalProperties": false,
        "properties": {
          "configuration_id": {
            "format": "uuid",
            "title": "Configuration Id",
            "type": "string"
          }
        },
        "required": [
          "configuration_id"
        ],
        "title": "GitHubInstallationStart",
        "type": "object"
      },
      "GitHubManifestComplete": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[A-Za-z0-9_-]{8,512}$",
            "title": "Code",
            "type": "string"
          },
          "display_name": {
            "default": "MVP Master GitHub",
            "maxLength": 200,
            "minLength": 2,
            "title": "Display Name",
            "type": "string"
          },
          "state": {
            "maxLength": 256,
            "minLength": 32,
            "title": "State",
            "type": "string"
          },
          "webhook_mode": {
            "$ref": "#/components/schemas/WebhookMode",
            "default": "POLLING"
          }
        },
        "required": [
          "state",
          "code"
        ],
        "title": "GitHubManifestComplete",
        "type": "object"
      },
      "GitHubManifestStart": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "default": "MVP Master GitHub",
            "maxLength": 200,
            "minLength": 2,
            "title": "Display Name",
            "type": "string"
          },
          "owner": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9-]{1,39}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner"
          },
          "webhook_mode": {
            "$ref": "#/components/schemas/WebhookMode",
            "default": "POLLING"
          }
        },
        "title": "GitHubManifestStart",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InternalPullRequestCreate": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "maxLength": 10000,
            "title": "Body",
            "type": "string"
          },
          "head_branch": {
            "maxLength": 250,
            "pattern": "^[A-Za-z0-9._/-]+$",
            "title": "Head Branch",
            "type": "string"
          },
          "head_sha": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{40}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Head Sha"
          },
          "idempotency_key": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Idempotency Key",
            "type": "string"
          },
          "organization_id": {
            "format": "uuid",
            "title": "Organization Id",
            "type": "string"
          },
          "repository_id": {
            "format": "uuid",
            "title": "Repository Id",
            "type": "string"
          },
          "title": {
            "maxLength": 300,
            "minLength": 2,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "body",
          "head_branch",
          "organization_id",
          "repository_id",
          "idempotency_key"
        ],
        "title": "InternalPullRequestCreate",
        "type": "object"
      },
      "ModelCredentialExchange": {
        "additionalProperties": false,
        "properties": {
          "capability": {
            "maxLength": 4096,
            "minLength": 64,
            "title": "Capability",
            "type": "string"
          }
        },
        "required": [
          "capability"
        ],
        "title": "ModelCredentialExchange",
        "type": "object"
      },
      "ModelCredentialWrite": {
        "additionalProperties": false,
        "description": "A model-provider API key value, submitted once by an organization admin.\n\nWrite-only: this endpoint returns only a `SecretReference` (identifiers), never\nthe value back. Delivery's provider-configuration create endpoint takes that\nreference, never a raw value.",
        "properties": {
          "display_name": {
            "default": "Coding agent credential",
            "maxLength": 200,
            "minLength": 2,
            "title": "Display Name",
            "type": "string"
          },
          "provider": {
            "default": "openai",
            "pattern": "^[a-z0-9-]{1,64}$",
            "title": "Provider",
            "type": "string"
          },
          "value": {
            "maxLength": 8192,
            "minLength": 1,
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "value"
        ],
        "title": "ModelCredentialWrite",
        "type": "object"
      },
      "PullRequestCreate": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "maxLength": 10000,
            "title": "Body",
            "type": "string"
          },
          "head_branch": {
            "maxLength": 250,
            "pattern": "^[A-Za-z0-9._/-]+$",
            "title": "Head Branch",
            "type": "string"
          },
          "head_sha": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{40}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Head Sha"
          },
          "title": {
            "maxLength": 300,
            "minLength": 2,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "body",
          "head_branch"
        ],
        "title": "PullRequestCreate",
        "type": "object"
      },
      "SourceCredentialExchange": {
        "additionalProperties": false,
        "properties": {
          "capability": {
            "maxLength": 4096,
            "minLength": 64,
            "title": "Capability",
            "type": "string"
          }
        },
        "required": [
          "capability"
        ],
        "title": "SourceCredentialExchange",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WebhookMode": {
        "enum": [
          "WEBHOOK",
          "POLLING"
        ],
        "title": "WebhookMode",
        "type": "string"
      }
    }
