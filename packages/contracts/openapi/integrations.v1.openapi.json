        "additionalProperties": false,
        "properties": {
          "body": {
            "maxLength": 10000,
            "title": "Body",
            "type": "string"
          },
          "head_branch": {
            "maxLength": 250,
            "pattern": "^[A-Za-z0-9._/-]+$",
            "title": "Head Branch",
            "type": "string"
