# Synthetic local-development values only. Never put real credentials here.
COMPOSE_PROJECT_NAME=mvp_master
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-postgres-only

KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-only
KEYCLOAK_ISSUER=http://keycloak:8080/realms/mvp-master
KEYCLOAK_BROWSER_ISSUER=http://localhost:8081/realms/mvp-master
KEYCLOAK_AUDIENCE=mvp-api
AUTH_SECRET=local-auth-secret-replace-outside-development

CONTROL_PLANE_DATABASE_URL=postgresql+asyncpg://control_plane:local-control-plane-only@postgres:5432/control_plane
INTEGRATIONS_DATABASE_URL=postgresql+asyncpg://integrations:local-integrations-only@postgres:5432/integrations
DELIVERY_DATABASE_URL=postgresql+asyncpg://delivery:local-delivery-only@postgres:5432/delivery

NATS_URL=nats://nats:4222
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=local-minio
MINIO_SECRET_KEY=local-minio-secret
MINIO_BUCKET=mvp-artifacts

CONTROL_PLANE_URL=http://control-plane:8000
INTEGRATIONS_URL=http://integrations:8000
DELIVERY_URL=http://delivery:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Use an externally reachable HTTPS URL here when enabling GitHub webhooks.
# Polling mode works with localhost and reconciles repository access every five minutes.
INTERNAL_SERVICE_TOKEN=local-internal-service-token-only

# Synthetic browser users imported into the local Keycloak realm:
# owner@example.test / local-owner-only
# reviewer@example.test / local-reviewer-only
# client@example.test / local-client-only

# Real integrations are disabled by default and require secret references.
GITHUB_ADAPTER=local
AGENT_ADAPTER=deterministic

# Real agent runtimes (claude-agent-sdk, claude-code-cli, codex-cli) require both a
# submitted model-credential secret reference AND scoped network egress explicitly
# enabled here. Off by default, matching the two adapters above — see
# docs/adrs/0009-scoped-model-provider-egress.md. A job that requests a real-agent
# runtime while this is false fails loudly rather than running without network.
AGENT_EGRESS_ENABLED=false
AGENT_EGRESS_NETWORK=mvp-agent-egress
AGENT_EGRESS_PROXY_IMAGE=vimagick/tinyproxy
AGENT_EGRESS_PROXY_PORT=3128
