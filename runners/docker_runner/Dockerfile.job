FROM node:22-slim AS node-runtime

FROM python:3.13.7-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
WORKDIR /app
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app app

# Node.js runtime + git, needed by the CLI-driven agent runtimes: claude-agent-sdk
# and claude-code-cli spawn the `claude` binary, codex-cli spawns `codex`, and the
# shared `adapters/agent_prompt.py::changed_paths` helper (used by all three) shells
# out to `git status`. Copied from the official Node image rather than installed via
# apt, since Debian slim's packaged Node is too old for these CLIs.
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
RUN apt-get update \
    && apt-get install --no-install-recommends -y git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Pinned versions — bump deliberately, not via a floating tag, and re-verify the
# NDJSON/stream-json event shapes each adapter parses (`adapters/codex_cli.py`,
# `adapters/claude_code_cli.py`) still match after any bump.
RUN npm install -g --no-fund --no-audit \
    @anthropic-ai/claude-code@2.1.220 \
    @openai/codex@0.145.0 \
    && npm cache clean --force

COPY pyproject.toml uv.lock ./
COPY packages/python_common packages/python_common
COPY runners/docker_runner runners/docker_runner
RUN pip install --no-cache-dir uv==0.11.16 && uv sync --frozen --package mvp-docker-runner --no-dev

# Writable HOME for the non-root job user — CLI/SDK config, cache, and (for
# LOCAL_SESSION auth) the copied-in OAuth session all live here at runtime, via the
# "/home/app" tmpfs mount configured in adapters/docker_agent.py (not baked into the
# image). This just creates the mountpoint; ownership matters for the *directory
# entry* itself even though the tmpfs mount that covers it at runtime is what's
# actually written to.
RUN mkdir -p /home/app && chown 10001:10001 /home/app
ENV HOME=/home/app

USER app
ENTRYPOINT []
